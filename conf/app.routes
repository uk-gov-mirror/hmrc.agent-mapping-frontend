->         /hmrc-frontend                      hmrcfrontend.Routes

#microservice specific routes
GET         /assets/*file                                        controllers.Assets.versioned(path = "/public", file: Asset)

GET         /                                                    uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.root
GET         /start                                               uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.start

GET         /start-submit                                        uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.returnFromGGLogin(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /agent-code                                          uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.showAgentCode(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
POST        /agent-code                                          uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.submitAgentCode(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /use-the-gg-user-id                                  uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.showUseTheGgUserId(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /sign-in-required                                    uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.needAgentServicesAccount
GET         /client-authorisations-added                         uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.showClientAuthorisationsAdded(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /error/wrong-sign-in-asa                             uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.wrongSignInDetailsAsa(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /error/wrong-sign-in-not-agent                       uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.wrongSignInDetailsNotAgent(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /error/problem-with-details                          uk.gov.hmrc.agentmappingfrontend.controllers.MappingController.problemWithDetails(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /signed-out-redirect                                 uk.gov.hmrc.agentmappingfrontend.controllers.SignedOutController.signOutAndRedirect(id: uk.gov.hmrc.agentmappingfrontend.repository.MappingResult.MappingArnResultId)
GET         /re-log-in-redirect                                  uk.gov.hmrc.agentmappingfrontend.controllers.SignedOutController.reLogForMappingStart

GET         /finish-sign-out                                     uk.gov.hmrc.agentmappingfrontend.controllers.SignedOutController.signOut
GET         /time-out                                            uk.gov.hmrc.agentmappingfrontend.controllers.SignedOutController.timeOut()
GET         /timed-out                                           uk.gov.hmrc.agentmappingfrontend.controllers.SignedOutController.timedOut

GET         /language/:lang                                      uk.gov.hmrc.agentmappingfrontend.controllers.AgentMappingLanguageController.switchToLanguage(lang: String)
